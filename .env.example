# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=
BOT_PASSCODE=123456

# Gemini API Key (Get free from https://aistudio.google.com/)
GEMINI_API_KEY=

# LinkedIn Developer Credentials
# Create App at: https://www.linkedin.com/developers/apps
# Products needed: "Share on LinkedIn" & "Sign In with LinkedIn using OpenID Connect"
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:3000/callback

# LinkedIn OAuth Tokens (Auto-filled by running: node auth.js)
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_PERSON_URN=

# Local OAuth Server Port
PORT=3000
